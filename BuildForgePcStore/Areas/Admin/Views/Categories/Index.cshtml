@model IEnumerable<BuildForgePcStore.Models.Entities.Category>
@{
    ViewData["Title"] = "Categories";
}

<partial name="_AdminNav" />

<h1 class="h3 mb-3">Categories</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Add category</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Products</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CategoryName</td>
            <td>@item.Products.Count</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.CategoryId">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.CategoryId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
