@using BuildForgePcStore.Helpers
<ul class="navbar-nav align-items-sm-center">
@if (Context.Session.IsLoggedIn())
{
    <li class="nav-item">
        <span class="navbar-text text-white-50 me-2">Hello, @Context.Session.GetUserName()</span>
    </li>
    @if (Context.Session.IsAdmin())
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">My Orders</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Index">My Account</a>
        </li>
    }
    <li class="nav-item">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link border-0 bg-transparent px-2">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
    </li>
}
</ul>
