@model CartViewModel
@{
    ViewData["Title"] = "Cart";
}
<h1 class="h3 mb-3">Shopping cart</h1>
@if (!Model.Lines.Any())
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Browse shop</a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td><img src="@line.ImagePath" alt="" style="height:48px" /></td>
                        <td>@line.ProductName</td>
                        <td>RM @line.UnitPrice.ToString("N2")</td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <input type="number" name="quantity" value="@line.Quantity" min="1"
                                       max="@line.Stock" class="form-control form-control-sm" style="width:70px" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td>RM @line.LineTotal.ToString("N2")</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="fs-5">Subtotal: <strong>RM @Model.Subtotal.ToString("N2")</strong></p>
    <a class="btn btn-success" asp-controller="Checkout" asp-action="Index">Checkout</a>
}