@model ProductEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="mb-3">
    <label asp-for="ProductName" class="form-label"></label>
    <input asp-for="ProductName" class="form-control" />
    <span asp-validation-for="ProductName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label"></label>
    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" id="categorySelect"></select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
</div>

<div class="mb-3" id="socketGroup">
    <label asp-for="Socket" class="form-label"></label>
    <select asp-for="Socket" class="form-select">
        <option value="">-- Select socket --</option>
        <option value="AM4">AM4</option>
        <option value="AM5">AM5</option>
        <option value="LGA1700">LGA1700</option>
        <option value="LGA1200">LGA1200</option>
    </select>
    <span asp-validation-for="Socket" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ImageFile" class="form-label"></label>
    <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
    <span asp-validation-for="ImageFile" class="text-danger"></span>
    @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
    {
        <div class="mt-2">
            <img src="@Model.CurrentImagePath" alt="Current" class="img-thumbnail" style="max-height:120px" />
        </div>
    }
</div>
